# Copiar a .env y completar. NUNCA commitear .env
# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com
# Para acceso por otro origen, incluir el esquema y puerto exactos.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Por defecto solo accesible desde la propia laptop.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
# Admin siempre ligado a localhost; usar SSH para acceso remoto privado.
ADMIN_PORT=8001
# Activar ambos valores para la entrada HTTPS con proxy de confianza al publicar.
DJANGO_REQUIRE_HTTPS=0
DJANGO_TRUST_PROXY_SSL=0
DJANGO_COOKIE_SECURE=1
DJANGO_CACHE_URL=redis://redis:6379/2
WEB_WORKERS=2
CELERY_CONCURRENCY=1

# --- Google login opcional (client ID público; no se requiere client secret) ---
GOOGLE_OAUTH_CLIENT_ID=

# Registro público y acceso por código: dejar en 0 hasta verificar SMTP y el despliegue.
PUBLIC_SIGNUP_ENABLED=0
EMAIL_LOGIN_ENABLED=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=

# --- Cloudflare Tunnel (opcional, perfil tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- PostgreSQL/PostGIS ---
POSTGRES_DB=geoinsight
POSTGRES_USER=geoinsight
POSTGRES_PASSWORD=cambiar-password-seguro

# --- Google Earth Engine (Service Account) ---
GEE_SERVICE_ACCOUNT=mi-sa@mi-proyecto.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=/credentials/gee-sa-key.json
GEE_PROJECT=mi-proyecto-gcp

# --- LLM (API compatible con OpenAI) ---
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com  | clave en https://platform.deepseek.com
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1 | clave en https://platform.openai.com
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
